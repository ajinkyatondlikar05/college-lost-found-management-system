# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

MONGO_URI=mongodb+srv://...
JWT_SECRET=your_super_secret_jwt_key_change_in_production
PORT=5000
ADMIN_EMAIL=admin@apsit.edu.in
ADMIN_PASSWORD=your_admin_password_here

# Email / SMTP Configuration (e.g. Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_college_o
EMAIL_PASSWORD=your_16_digit_gmail_app_password
EMAIL_FROM="APSIT Lost & Found" <your_college_or_admin_email@gmail.com>
